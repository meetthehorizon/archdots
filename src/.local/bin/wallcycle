#!/usr/bin/env bash
# Cycle to a random wallpaper using awww (seamless transition)
# Usage: wallcycle [dir]   (defaults to ~/Pictures/wallpapers-pc)
dir="${1:-$HOME/Pictures/wallpapers-pc}"
img="$(find "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) 2>/dev/null | shuf -n 1)"
[ -n "$img" ] && awww img "$img" --transition-type simple
